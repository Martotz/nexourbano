# Copiar a .env y completar. .env NO se commitea (está en .gitignore).
# Una API key en Git son -15 puntos.

# --- Squad ---
SEED=2002
CIUDAD=Buenos Aires

# --- MySQL (CRM riders, Sqoop / Spark JDBC) ---
MYSQL_ROOT_PASSWORD=cambiar
MYSQL_PORT=3307

# --- MongoDB ---
MONGO_PORT=27017
MONGO_URI=mongodb://localhost:27017

# --- Cassandra ---
CASSANDRA_PORT=9042

# --- Neo4j ---
NEO4J_PASSWORD=cambiar-min-8-caracteres
NEO4J_URI=bolt://localhost:7687

# --- MinIO (plan B del Data Lake) ---
MINIO_ROOT_USER=nexo
MINIO_ROOT_PASSWORD=cambiar-min-8-caracteres
MINIO_ENDPOINT=http://localhost:9000

# --- Azure Data Lake Gen2 ---
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=

# --- Clima (Open-Meteo no necesita key; OpenWeather sí) ---
OPENWEATHER_API_KEY=

# --- Social (Bluesky searchPosts pide login: usar App Password, no la contraseña real) ---
BSKY_HANDLE=
BSKY_APP_PASSWORD=
